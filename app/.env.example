# Supabase connection details.
#
# Both values are PUBLIC by design and ship in the frontend bundle. The anon
# key is not a secret — Row Level Security is the security boundary. In CI
# these belong in GitHub *repository variables*, not secrets.
#
# The service_role key must NEVER appear here, in the repo, or in the bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
